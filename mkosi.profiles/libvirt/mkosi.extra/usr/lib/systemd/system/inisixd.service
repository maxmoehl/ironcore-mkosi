[Unit]
Description=IronCore inisix daemon (DHCPv6 server for inisix taps)
# Serves prefixes from the inisix prefix store, hence starts only after the
# oneshot store init. libvirt-provider.service in turn orders After= this
# unit so guests never attach before DHCPv6 is up.
After=init-inisix.service

[Service]
ExecStart=/usr/local/bin/inisixd
Restart=on-failure

[Install]
WantedBy=hypervisor.target
