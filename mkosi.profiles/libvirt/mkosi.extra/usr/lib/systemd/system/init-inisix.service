[Unit]
Description=Initialize the inisix prefix store
ConditionPathExists=!/var/lib/inisix/prefixes.json
Wants=cloud-init.target
After=cloud-init.target
Before=libvirt-provider.service machinepoollet.service

[Service]
Type=oneshot
TimeoutStartSec=5min
User=libvirt-provider
Group=libvirt-provider
ExecStart=/usr/local/bin/inisix-init.sh

[Install]
WantedBy=hypervisor.target
