[Unit]
Description=Cloud Hypervisor Provider
Wants=cloud-init.target network-online.target
Requires=chp-qmp.service chp-kvm.service
After=cloud-init.target chp-qmp.service chp-kvm.service network-online.target systemd-tmpfiles-setup.service

[Service]
Type=simple
User=chp
Group=chp
SupplementaryGroups=kvm
EnvironmentFile=-/etc/cloud-hypervisor-provider/provider.env
RuntimeDirectory=chp
RuntimeDirectoryMode=0775
ExecStartPre=/usr/local/libexec/cloud-hypervisor-provider/validate-host
ExecStart=/usr/local/bin/cloud-hypervisor-provider \
  --address /run/chp/iri-machinebroker.sock \
  --provider-root-dir /var/lib/chp \
  --provider-machine-store-dir /var/lib/chp/store \
  --qmp-socket-path /run/chp/qmp/sock \
  --cloud-hypervisor-bin-path /usr/local/bin/cloud-hypervisor \
  --cloud-hypervisor-firmware-path /usr/local/bin/CLOUDHV_EFI.fd \
  --network-interface-plugin-name isolated \
  --machine-class ${CHP_MACHINE_CLASS}
Restart=on-failure
RestartSec=1
LimitNOFILE=1048576

[Install]
WantedBy=hypervisor.target
