#!/bin/sh
set -eu

export GOTOOLCHAIN=auto
export GOPATH="$BUILDDIR/go/path"
export GOCACHE="$BUILDDIR/go/buildcache"
export GOMODCACHE="$BUILDDIR/go/modcache"
export CGO_ENABLED=0

if [ ! -f "$SRCDIR/src/inisix/go.mod" ]; then
    echo "error: src/inisix is not checked out, run:" >&2
    echo "    git submodule update --init src/inisix" >&2
    exit 1
fi

mkdir -p "$DESTDIR/usr/local/bin"

cd "$SRCDIR/src/inisix"

go build -trimpath \
    -o "$DESTDIR/usr/local/bin/inisix" \
    ./cmd/inisix
