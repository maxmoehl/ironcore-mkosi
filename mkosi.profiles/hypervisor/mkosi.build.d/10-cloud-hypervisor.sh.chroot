#!/bin/sh
set -eu

# cloud-hypervisor built with --features fw_cfg from ironcore-dev/cloud-hypervisor-provider,
# see https://github.com/ironcore-dev/cloud-hypervisor-provider/releases/tag/cloud-hypervisor-fw_cfg
REPO=ironcore-dev/cloud-hypervisor-provider
TAG=cloud-hypervisor-fw_cfg

case "$ARCHITECTURE" in
x86-64)
    ASSET=cloud-hypervisor-static
    SHA256=9e32e15004fe8310597fe70569cc6d38644ce360fc824b9c690f2e2d0d32305b
    ;;
arm64)
    ASSET=cloud-hypervisor-static-aarch64
    SHA256=1afef60174976d19896a77b316e9d50c895de4bb5f42a907ac8df49a96d4dbcd
    ;;
*)
    echo "error: unsupported architecture: $ARCHITECTURE" >&2
    exit 1
    ;;
esac

mkdir -p "$DESTDIR/usr/local/bin"

curl -fsSL \
    -o "$DESTDIR/usr/local/bin/cloud-hypervisor" \
    "https://github.com/$REPO/releases/download/$TAG/$ASSET"

echo "$SHA256  $DESTDIR/usr/local/bin/cloud-hypervisor" | sha256sum -c -

chmod 0755 "$DESTDIR/usr/local/bin/cloud-hypervisor"
